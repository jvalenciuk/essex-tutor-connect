
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARENT
  TUTOR
  ADMIN
}

enum Verification {
  PENDING
  APPROVED
  REJECTED
}

enum InquiryStatus {
  OPEN
  ACCEPTED
  DECLINED
}

enum BookingStatus {
  PROPOSED
  CHANGE_REQUESTED
  DECLINED
  PENDING_PAYMENT
  PAID
  COMPLETED
  CANCELLED
  REFUNDED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  passwordHash  String
  role          Role          @default(PARENT)
  createdAt     DateTime      @default(now())

  tutor         TutorProfile?
  sentInquiries Inquiry[]     @relation("ParentInquiries")
  bookings      Booking[]     @relation("ParentBookings")
  messages      Message[]
}

model TutorProfile {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id])

  bio              String       @default("")
  subjects         String[]
  grades           String[]
  cities           String[]
  languages        String[]
  hourlyRateCents  Int
  online           Boolean      @default(false)
  verification     Verification @default(PENDING)
  qualifications   String       @default("")
  stripeAccountId  String?      @unique

  inquiries        Inquiry[]
  bookings         Booking[]
  availability     TutorAvailability[]
  blockedDates     TutorBlockedDate[]

  createdAt        DateTime     @default(now())
}

model TutorAvailability {
  id          String       @id @default(cuid())
  tutorId     String
  tutor       TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  dayOfWeek   Int
  startMinute Int
  endMinute   Int

  @@index([tutorId, dayOfWeek])
}

model TutorBlockedDate {
  id       String       @id @default(cuid())
  tutorId  String
  tutor    TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  dateKey  String

  @@unique([tutorId, dateKey])
}

model Inquiry {
  id        String        @id @default(cuid())
  parentId  String
  parent    User          @relation("ParentInquiries", fields: [parentId], references: [id])

  tutorId   String
  tutor     TutorProfile  @relation(fields: [tutorId], references: [id])

  subject   String
  grade     String
  message   String
  status    InquiryStatus @default(OPEN)
  createdAt DateTime      @default(now())

  messages  Message[]
  bookings  Booking[]

  @@index([tutorId, status])
}

model Message {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id])

  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])

  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  @@index([inquiryId, createdAt])
}

model Booking {
  id               String        @id @default(cuid())

  inquiryId        String?
  inquiry          Inquiry?      @relation(fields: [inquiryId], references: [id])

  parentId         String
  parent           User          @relation("ParentBookings", fields: [parentId], references: [id])

  tutorId          String
  tutor            TutorProfile  @relation(fields: [tutorId], references: [id])

  startsAt         DateTime
  durationMinutes  Int

  requestedStartsAt        DateTime?
  requestedDurationMinutes Int?
  requestNote              String? @db.VarChar(1000)

  amountCents      Int
  platformFeeCents Int

  status           BookingStatus @default(PROPOSED)

  stripeSessionId  String?       @unique

  notifications    NotificationDelivery[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tutorId, startsAt])
  @@index([inquiryId])
  @@index([parentId, status])
}

model NotificationDelivery {
  id             String             @id @default(cuid())
  bookingId      String
  booking        Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type           String
  recipientRole  String
  recipientEmail String
  status         NotificationStatus @default(PENDING)

  attempts       Int                @default(0)
  idempotencyKey String             @unique
  providerId     String?
  lastError      String?            @db.VarChar(1000)
  sentAt         DateTime?

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([bookingId, type, recipientRole])
  @@index([status, updatedAt])
}
